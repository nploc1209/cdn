    "wrangler": "^4.145.0"
  },
  "name": "cdn",
  "version": "1.0.0",
  "description": "",
  "main": "script.js",
  "dependencies": {
    "blake3-wasm": "^2.1.5",
    "cookie": "^1.1.1",
    "detect-libc": "^2.1.2",
    "error-stack-parser-es": "^1.0.5",
    "esbuild": "^0.28.1",
    "kleur": "^4.1.5",
    "miniflare": "^5.20260930.0-alpha",
    "path-to-regexp": "^6.3.0",
    "pathe": "^2.0.3",
    "semver": "^7.8.5",
    "sharp": "^0.35.4",
    "supports-color": "^10.2.2",
    "tslib": "^2.8.1",
    "undici": "^7.29.1",
    "unenv": "^2.0.0-rc.24",
    "workerd": "^1.20260930.2",
    "ws": "^8.21.0",
    "youch": "^4.1.0-beta.10",
    "youch-core": "^0.3.3"
  },
  "scripts": {
    "sync-assets": "mkdir -p public && cp -f index.html status.html docs.html account.html auth.html style.css script.js public/",
    "dev": "npm run sync-assets && wrangler dev",
    "deploy": "npm run sync-assets && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cdn-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cdn-db --remote",
    "logs:clear": "wrangler d1 execute cdn-db --remote --command=\"DELETE FROM logs;\"",
    "logs:clear:local": "wrangler d1 execute cdn-db --local --command=\"DELETE FROM logs;\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nploc1209/cdn.git"
